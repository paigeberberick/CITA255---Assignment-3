<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CITA255___Assignment_3.HealthPotionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Health Potion">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Health Potion" FontSize="28" />
        <Label Text="$9.99" FontSize="22" />
            
        <!-- i had to look up how to add commentts, but i was thinking originally of making the currency gold, but i wasnt sure how that would work for the checkout once we make that -->
        
        <Label Text="How many would you like to purchase, traveller?" />
        <Entry x:Name="QuantityEntry" Text="1" Keyboard="Numeric" />

        <Button Text="Add to Cart" Clicked="OnAddToCartClicked" />

    </VerticalStackLayout>
</ContentPage>