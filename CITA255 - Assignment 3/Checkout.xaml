<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CITA255___Assignment_3.CheckoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Checkout">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="25" RowSpacing="15">

        <Label
            Grid.Row="0"
            Text="The haul for your next adventure..."
            FontSize="40" />

        <Label
            Grid.Row="1"
            Text="Nothing in here yet."
            FontSize="20"
            TextColor="Gray" />

        <Label
            Grid.Row="3"
            Text="Total:  $0.00"
            FontSize="30"
            HorizontalOptions="End" />

        <Button
            Grid.Row="4"
            Text="Checkout"
            FontSize="20"
            TextColor="Black"
            BackgroundColor= "MediumPurple"
            CornerRadius="12"
            HeightRequest="60" />

    </Grid>
</ContentPage>